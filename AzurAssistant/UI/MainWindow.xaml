         <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdates" IsEnabled="{Binding CanCheckUpdates}" Padding="14,7" Margin="12,0,0,0" />
         <Button x:Name="VersionNotesButton" Content="版本说明" Click="OnVersionNotes" Padding="14,7" Margin="8,0,0,0" />
         <Button Content="取消" Click="OnCancelUpdate" Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}" Padding="14,7" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <Grid x:Name="RoutesPage" Visibility="{Binding IsRoutesPage, Converter={StaticResource BoolVisibility}}">
      <Grid.Resources>
       <Style x:Key="RouteAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="9,4"/><Setter Property="Height" Value="34"/>
       </Style>
       <Style x:Key="RoutePrimary" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
        <Setter Property="Padding" Value="9,4"/><Setter Property="Height" Value="34"/>
       </Style>
       <Style x:Key="RouteIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="30"/><Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="4"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Path Data="{Binding}" Stroke="{DynamicResource Ink}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/></DataTemplate></Setter.Value></Setter></Style>
