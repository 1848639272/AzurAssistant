        <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,4"/>
       </Style>
       <DataTemplate x:Key="RouteChoiceName"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
       <Style x:Key="RouteCoordinateInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="15,4,6,4"/>
       </Style>
       <Style x:Key="RouteAxis" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
       </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid x:Name="RouteOperations">
       <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="*"/>
       </Grid.RowDefinitions>

       <Grid x:Name="RouteTopSection">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="RouteMountHint" Text="暂不支持坐骑状态下使用路线功能" Foreground="{DynamicResource WarningInk}" FontSize="11" Margin="0,6,0,16"/>
         <Grid Grid.Row="1" x:Name="RouteLibrary" Margin="0,0,0,16">
          <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsRouteDraftOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="24"/>
           <RowDefinition Height="Auto"/><RowDefinition Height="1.4*" MaxHeight="34"/>
           <RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="24"/>
           <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button x:Name="RouteRecordButton" Content="路线录制" Click="OnBeginRouteRecording" IsEnabled="{Binding CanBeginRoute}" Style="{StaticResource RoutePrimary}"/>
          <Button Grid.Column="2" x:Name="RouteImportButton" Content="路线导入" Click="OnImportRoute" IsEnabled="{Binding CanBeginRoute}" Style="{StaticResource RouteAction}"/>
          <ComboBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="RouteSelector" ItemsSource="{Binding SavedRoutes}" ItemTemplate="{StaticResource RouteChoiceName}" SelectedItem="{Binding SelectedRoute}" ToolTip="{Binding SelectedRoute.Name}" IsEnabled="{Binding CanBeginRoute}" Style="{StaticResource RouteChoice}" AutomationProperties.Name="已保存路线"/>
          <Button Grid.Row="2" Grid.Column="4" x:Name="RouteFolderButton" HorizontalAlignment="Left" Content="M1,4 L6.5,4 8,6 15,6 15,14 1,14 Z M1,7.5 L15,7.5" Style="{StaticResource RouteIcon}" Width="34" Height="34" Click="OnOpenRouteDirectory" AutomationProperties.Name="打开路线文件夹" ToolTip="打开路线文件夹"/>
          <Button Grid.Row="4" x:Name="RouteRunButton" Content="运行路线" Click="OnRunRoute" IsEnabled="{Binding CanRunRoute}" Style="{StaticResource RoutePrimary}"/>
          <CheckBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" x:Name="RouteAutoPickupBox" Content="拾取辅助（采集物、挖矿、砍树）" ToolTip="到点停稳后开启。普通采集连续两次确认提示消失后继续，砍树和挖矿按 F 后原地等待 10 秒。" IsChecked="{Binding RouteAutoPickup}" IsEnabled="{Binding CanRunRoute}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <Button Grid.Row="6" x:Name="RouteEditButton" Content="编辑路线" Click="OnEditRoute" IsEnabled="{Binding CanRunRoute}" Style="{StaticResource RouteAction}"/>
          <Button Grid.Row="6" Grid.Column="2" x:Name="RouteExportButton" Content="导出路线" Click="OnExportRoute" IsEnabled="{Binding CanRunRoute}" Style="{StaticResource RouteAction}"/>
          <Button Grid.Row="6" Grid.Column="4" x:Name="RouteDeleteButton" Content="删除路线" Click="OnDeleteRoute" IsEnabled="{Binding CanRunRoute}" Style="{StaticResource RouteAction}"/>
         </Grid>

         <Grid Grid.Row="1" x:Name="RouteRecordingPanel" VerticalAlignment="Top" Visibility="{Binding IsRouteDraftOpen, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button x:Name="RouteCaptureButton" Content="记录当前点" Click="OnCaptureRoutePoint" IsEnabled="{Binding CanCaptureRoutePoint}" Style="{StaticResource RouteAction}"/>
          <Button Grid.Column="2" Content="前往目标传送点" Click="OnRecordTeleport" IsEnabled="{Binding CanRecordTeleport}" Style="{StaticResource RouteAction}"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="路线名称" FontWeight="SemiBold" Margin="0,22,0,6"/>
          <TextBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="RouteNameBox" Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" Height="34" MaxLength="80" Padding="8,4" IsEnabled="{Binding CanChangeDraft}"/>
          <Button Grid.Row="3" x:Name="RouteSaveButton" Content="保存路线" Click="OnSaveRecordedRoute" IsEnabled="{Binding CanSaveRoute}" Style="{StaticResource RoutePrimary}" Margin="0,20,0,0"/>
          <Button Grid.Row="3" Grid.Column="2" Content="取消修改" IsEnabled="{Binding CanCancelDraft}" Click="OnCancelRouteRecording" Style="{StaticResource RouteAction}" Margin="0,20,0,0"/>
         </Grid>
       </Grid>

       <Border Grid.Row="1" Background="{DynamicResource DividerBrush}"/>
       <Grid Grid.Row="2" x:Name="RouteBottomSection">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="NavigationCoordinateCard" Background="{DynamicResource SidebarBackground}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
         <StackPanel>
          <DockPanel>
           <TextBlock x:Name="NavigationMapLabel" DockPanel.Dock="Right" Text="{Binding NavigationMapText}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
           <TextBlock Text="角色坐标" FontWeight="SemiBold" FontSize="14"/>
          </DockPanel>
          <TextBlock x:Name="NavigationCoordinateLabel" Text="{Binding NavigationCoordinateText}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,1" ToolTip="角色箭头朝向：北0°，东90°，南180°，西270°"/>
          <TextBlock Text="{Binding NavigationObservationText}" FontSize="11" Foreground="{DynamicResource Muted}"/>
         </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Button x:Name="NavigationObserveButton" Content="定位测试" Click="OnNavigationObserve" IsEnabled="{Binding CanStartNavigation}" Style="{StaticResource RouteAction}"/>
         <Button Grid.Column="2" Content="填入观测坐标" Click="OnUseObservedCoordinate" Style="{StaticResource RouteAction}"/>
        </Grid>
        <Grid Grid.Row="2" x:Name="NavigationTargetFields" Margin="0,12,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="184"/><ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*" MaxWidth="184"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="104"/>
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="9"/><RowDefinition Height="34"/></Grid.RowDefinitions>
         <TextBox x:Name="NavigationXBox" Text="{Binding NavigationX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RouteCoordinateInput}" MaxLength="9" AutomationProperties.Name="目标X坐标"/>
         <TextBlock Text="X" Style="{StaticResource RouteAxis}"/>
         <TextBox Grid.Column="2" x:Name="NavigationYBox" Text="{Binding NavigationY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RouteCoordinateInput}" MaxLength="9" AutomationProperties.Name="目标Y坐标"/>
         <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource RouteAxis}"/>
         <Button Grid.Column="4" x:Name="NavigationMoveButton" Content="前往指定坐标" Click="OnNavigationMove" IsEnabled="{Binding CanMoveToCoordinate}" Style="{StaticResource RouteAction}" ToolTip="限当前地图起点 250 像素内，X 向右、Y 向下"/>
         <ComboBox Grid.Row="2" x:Name="NavigationMapSelector" ItemsSource="{Binding NavigationMaps}" ItemTemplate="{StaticResource RouteChoiceName}" SelectedItem="{Binding SelectedTeleportMap}" IsEnabled="{Binding CanConfigure}" Style="{StaticResource RouteChoice}" AutomationProperties.Name="目标地图" ToolTip="{Binding SelectedTeleportMap.Name}"/>
         <ComboBox Grid.Row="2" Grid.Column="2" x:Name="NavigationTeleportSelector" ItemsSource="{Binding TeleportChoices}" ItemTemplate="{StaticResource RouteChoiceName}" SelectedItem="{Binding SelectedTeleport}" IsEnabled="{Binding CanConfigure}" Style="{StaticResource RouteChoice}" AutomationProperties.Name="导航传送点" ToolTip="{Binding SelectedTeleport.Name}"/>
         <Button Grid.Row="2" Grid.Column="4" x:Name="NavigationTeleportButton" Content="前往传送点" Click="OnNavigationTeleport" IsEnabled="{Binding CanStartNavigation}" Style="{StaticResource RouteAction}"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding RouteMessage}" ToolTip="{Binding RouteMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/>
       </Grid>
      </Grid>
      <Border Grid.Column="2" x:Name="RoutePointsPanel" Background="{DynamicResource TileBackground}" CornerRadius="8" Padding="11">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="路线点位" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding ElementName=RouteRows, Path=Items.Count, StringFormat={}{0} 个点}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
        <ListBox x:Name="RouteRows" Grid.Row="1" ItemsSource="{Binding VisibleRoutePoints}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Number}" MinWidth="18" VerticalAlignment="Top" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,4,0"/>
           <StackPanel Grid.Column="1">
            <Grid>
             <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsRouteDraftOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
             <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DataContext.IsRouteDraftOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" MaxLength="80" Padding="4,2" IsEnabled="{Binding DataContext.CanChangeDraft, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="点位名称"/>
            </Grid>
            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
           </StackPanel>
           <Button Grid.Column="2" Content="M2,4 L14,4 M5,4 L5,2 11,2 11,4 M3.5,4 L4.5,14 11.5,14 12.5,4 M6.5,6.5 L7,11.5 M9.5,6.5 L9,11.5" Click="OnRemoveRoutePoint" Style="{StaticResource RouteIcon}" IsEnabled="{Binding DataContext.CanRemovePoint, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="删除点位" ToolTip="删除点位，保存路线后生效"/>
          </Grid></Border>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </Grid>
      </Border>
     </Grid>
     <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock Text="{Binding SettingsError}" Visibility="{Binding HasSettingsError, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource WarningInk}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding TaskStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="以管理员重启" Click="OnRestartElevated" Visibility="{Binding RequiresElevation, Converter={StaticResource BoolVisibility}}" Padding="12,7" Margin="0,0,8,0" />
        <Button x:Name="CancelTaskButton" Content="停止任务" Click="OnCancelTask" IsEnabled="{Binding CanStopTask}" Padding="14,7" ToolTip="{Binding StopTaskTooltip}" />
       </StackPanel>
      </Grid>
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="ConsolePanels" Grid.Row="3" Height="252" Visibility="{Binding IsHomePage, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" />
     <ColumnDefinition x:Name="PreviewGapColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="20" /><Style.Triggers><DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
     <ColumnDefinition x:Name="PreviewColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="300" /><Style.Triggers><DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <Border x:Name="LogPanel" Style="{StaticResource Card}" Padding="20,18">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,12"><TextBlock Text="日志" FontSize="15" FontWeight="SemiBold" /><Button Content="打开文件夹" Click="OnOpenLogs" HorizontalAlignment="Right" FontSize="10" Padding="8,4" /></Grid>
      <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="{Binding LogError}" Visibility="{Binding HasLogError, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <ItemsControl ItemsSource="{Binding Logs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,13" LineHeight="19" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      </Grid>
     </Grid>
    </Border>
    <Border x:Name="PreviewPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,14,12" Visibility="{Binding ShowPreview, Converter={StaticResource BoolVisibility}}">
     <StackPanel>
      <Grid Margin="2,0,2,12"><TextBlock Text="游戏画面" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="实时预览" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" /></Grid>
      <Border Background="{DynamicResource PreviewBackground}" CornerRadius="7" Height="150" ClipToBounds="True">
       <Grid>
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="游戏实时画面" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PreviewMuted}" FontSize="28" HorizontalAlignment="Center" /><TextBlock Text="{Binding PreviewHint}" Foreground="{DynamicResource PreviewInk}" FontSize="12" Margin="0,12,0,0" />
        </StackPanel>
       </Grid>
      </Border>
      <TextBlock Text="{Binding FrameInfo}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,12,0,0" />
      <TextBlock Text="{Binding FrameTime}" FontSize="10" Foreground="{DynamicResource Subtle}" Margin="2,5,0,0" />
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock Grid.Row="4" Text="画面仅在本机显示" Visibility="{Binding ShowPreviewFootnote, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Subtle}" FontSize="10" HorizontalAlignment="Right" Margin="0,14,2,0" />
  </Grid>
  <Canvas x:Name="DailyDragOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
   <Image x:Name="DailyDragImage" Opacity="0.65" Stretch="Fill">
    <Image.Effect><DropShadowEffect Color="#28464D" BlurRadius="12" ShadowDepth="3" Opacity="0.22" /></Image.Effect>
   </Image>
  </Canvas>
 </Grid>
</Window>
