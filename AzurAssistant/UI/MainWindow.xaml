        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
         <Button x:Name="RouteRecordButton" Content="路线录制" Click="OnBeginRouteRecording" IsEnabled="{Binding CanBeginRoute}" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="RouteImportButton" Content="路线导入" Click="OnImportRoute" IsEnabled="{Binding CanBeginRoute}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding RouteMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14" />
        <StackPanel x:Name="RouteRecordingPanel" Visibility="{Binding IsRecordingRoute, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="{Binding RecordingMapText}" FontWeight="SemiBold" Margin="0,0,0,10" />
         <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button x:Name="RouteCaptureButton" Content="记录当前点" Click="OnCaptureRoutePoint" IsEnabled="{Binding CanCaptureRoutePoint}" />
          <Button Content="取消录制" Click="OnCancelRouteRecording" IsEnabled="{Binding CanCaptureRoutePoint}" Margin="10,0,0,0" />
         </StackPanel>
         <ItemsControl ItemsSource="{Binding RecordedPoints}" IsEnabled="{Binding CanCaptureRoutePoint}">
          <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="115" /><ColumnDefinition Width="115" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,10,0" AutomationProperties.Name="点位名称" />
           <TextBlock Grid.Column="1" Text="{Binding X, StringFormat=X {0:F2}}" VerticalAlignment="Center" />
           <TextBlock Grid.Column="2" Text="{Binding Y, StringFormat=Y {0:F2}}" VerticalAlignment="Center" />
           <Button Grid.Column="3" Content="移除" Click="OnRemoveRoutePoint" Padding="10,5" />
          </Grid></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="路线名称" FontWeight="SemiBold" Margin="0,12,0,7" />
         <TextBox x:Name="RouteNameBox" Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanCaptureRoutePoint}" />
         <CheckBox x:Name="RouteAutoPickupBox" Content="运行时开启自动拾取辅助" IsChecked="{Binding RouteAutoPickup}" IsEnabled="{Binding CanCaptureRoutePoint}" Margin="0,12,0,12" />
         <Button x:Name="RouteSaveButton" Content="完成并保存路线" Click="OnSaveRecordedRoute" IsEnabled="{Binding CanSaveRoute}" HorizontalAlignment="Left" Style="{StaticResource PrimaryAction}" Margin="0,0,0,20" />
        </StackPanel>
        <TextBlock Text="已保存路线" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" />
        <ComboBox x:Name="RouteSelector" ItemsSource="{Binding SavedRoutes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRoute}" IsEnabled="{Binding CanBeginRoute}" />
        <TextBlock Text="{Binding SelectedRouteDescription}" Foreground="{DynamicResource Muted}" Margin="0,9,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <Button x:Name="RouteRunButton" Content="运行路线" Click="OnRunRoute" IsEnabled="{Binding CanRunRoute}" Style="{StaticResource PrimaryAction}" />
         <Button Content="导出 JSON" Click="OnExportRoute" IsEnabled="{Binding CanRunRoute}" Margin="10,0,0,0" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding SelectedRoutePoints}"><ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="115" /><ColumnDefinition Width="115" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding X, StringFormat=X {0:F2}}" /><TextBlock Grid.Column="2" Text="{Binding Y, StringFormat=Y {0:F2}}" />
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="同地图路线依次前往各点。开头跳跃一次，途中自动转向前进；请在转弯和障碍附近补点，当前不自动绕障。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,16" />
        <TextBlock Text="编辑路线（预览与修改）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="一条路线就是从 A 点走到 B 点、再走到 C 点。下表每行是一个点位：名称自己看得懂就行；X/Y 是地图坐标（左上角 0,0，X 向右、Y 向下，和导航测试页同一套）。改完点“保存修改”直接覆盖这条路线。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{Binding RoutePreviewText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource Subtle}" />
        <ItemsControl ItemsSource="{Binding EditableRoutePoints}">
         <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,8,0" AutomationProperties.Name="点位名称" />
          <TextBox Grid.Column="1" Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,8,0" AutomationProperties.Name="点位X坐标" />
          <TextBox Grid.Column="2" Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,8,0" AutomationProperties.Name="点位Y坐标" />
          <Button Grid.Column="3" Content="移除" Click="OnRemoveEditedRoutePoint" Padding="10,5" />
         </Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <Button x:Name="SaveEditedRouteButton" Content="保存修改" Click="OnSaveEditedRoute" IsEnabled="{Binding CanEditRoute}" Style="{StaticResource PrimaryAction}" />
         <Button Content="追加当前坐标" Click="OnAddEditedRoutePoint" IsEnabled="{Binding CanEditRoute}" Margin="10,0,0,0" />
        </StackPanel>
       </StackPanel>
       <StackPanel x:Name="ActionsPage" Visibility="{Binding IsActionsPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="录制你自己的真实键鼠操作，再按原时序回放。录制期间助手只旁听，不会干预游戏。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <Button x:Name="ActionRecordButton" Content="开始录制" Click="OnBeginActionRecording" IsEnabled="{Binding CanBeginActionRecording}" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="ActionStopRecordButton" Content="停止录制" Click="OnStopActionRecording" IsEnabled="{Binding CanStopActionRecording}" Margin="10,0,0,0" />
         <Button Content="刷新列表" Click="OnRefreshActions" Margin="10,0,0,0" />
         <Button Content="导入动作" Click="OnImportAction" IsEnabled="{Binding CanBeginActionRecording}" Margin="10,0,0,0" />
         <Button Content="导出选中" Click="OnExportAction" IsEnabled="{Binding CanPlayAction}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="动作名称（保存或重命名时使用）" FontWeight="SemiBold" Margin="0,0,0,7" />
        <TextBox x:Name="ActionNameBox" Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanBeginActionRecording}" />
        <TextBlock Text="{Binding ActionRecordingText}" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,18" />
        <TextBlock Text="已保存的动作" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" />
        <ComboBox x:Name="ActionSelector" ItemsSource="{Binding SavedActions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAction}" IsEnabled="{Binding CanBeginActionRecording}" />
        <TextBlock Text="{Binding SelectedActionSummary}" Foreground="{DynamicResource Muted}" Margin="0,9,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <Button x:Name="ActionPlayButton" Content="回放选中动作" Click="OnPlayAction" IsEnabled="{Binding CanPlayAction}" Style="{StaticResource PrimaryAction}" />
         <Button Content="重命名" Click="OnRenameAction" IsEnabled="{Binding CanPlayAction}" Margin="10,0,0,0" />
         <Button Content="删除" Click="OnDeleteAction" IsEnabled="{Binding CanPlayAction}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="编辑选中动作（时间点与按住时长）" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />
        <TextBlock Text="每行是一次输入：“时刻”是相对动作开始的毫秒数（1000 = 1 秒）；“持续”是按下到松开的毫秒数，只对按键和点击有效。改完点“保存修改”会覆盖这个动作文件。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{Binding ActionEditSummary}" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding EditableActionEvents}">
         <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" />
          <TextBox Grid.Column="2" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Margin="0,0,8,0" ToolTip="相对动作开始的毫秒数" AutomationProperties.Name="事件时刻毫秒" />
          <TextBox Grid.Column="3" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,0,8,0" IsEnabled="{Binding CanEditDuration}" ToolTip="按下到松开的毫秒数" AutomationProperties.Name="按住时长毫秒" />
          <Button Grid.Column="4" Content="移除" Click="OnRemoveEditedActionRow" Padding="10,5" />
         </Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="SaveEditedActionButton" Content="保存修改" Click="OnSaveEditedAction" IsEnabled="{Binding CanEditAction}" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        <TextBlock Text="回放会把游戏切到前台，并按录制时序注入键鼠：按键保持原来的按下时长，鼠标转动按原来的位移，点击落在同一客户区位置。回放期间按 F10 停止；暂停（F9）不适用于回放。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0" />
       </StackPanel>
       <StackPanel x:Name="WheelchairPage" Visibility="{Binding IsWheelchairPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="把“走到某个坐标 → 执行某个动作 → 再走到下一个坐标”串成流水线，可导入导出分享给别人。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <Button x:Name="WheelchairNewButton" Content="新建方案" Click="OnBeginWheelchairDraft" IsEnabled="{Binding CanBeginWheelchair}" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="WheelchairCaptureButton" Content="记录当前坐标" Click="OnCaptureWheelchairStep" IsEnabled="{Binding CanCaptureWheelchairStep}" Margin="10,0,0,0" />
         <Button Content="导入方案" Click="OnImportWheelchairPlan" IsEnabled="{Binding CanBeginWheelchair}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding WheelchairStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14" />
        <StackPanel x:Name="WheelchairDraftPanel" Visibility="{Binding IsWheelchairDrafting, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="方案名称" FontWeight="SemiBold" Margin="0,0,0,7" />
         <TextBox x:Name="WheelchairNameBox" Text="{Binding WheelchairName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
         <TextBlock Text="步骤：到达坐标后执行的动作（留空则只走位），最后一列是到达后等待秒数" FontWeight="SemiBold" Margin="0,14,0,8" />
         <ItemsControl ItemsSource="{Binding WheelchairSteps}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="115" /><ColumnDefinition Width="175" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,8,0" AutomationProperties.Name="步骤名称" />
            <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ActionChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Action}" Margin="6,0" AutomationProperties.Name="步骤动作" />
            <TextBox Grid.Column="3" Text="{Binding DelayText}" MaxLength="3" Margin="0,0,8,0" ToolTip="到达后等待多少秒再执行动作" AutomationProperties.Name="等待秒数" />
            <Button Grid.Column="4" Content="移除" Click="OnRemoveWheelchairStep" Padding="10,5" />
           </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
          <Button x:Name="WheelchairSaveButton" Content="保存方案" Click="OnSaveWheelchairPlan" IsEnabled="{Binding CanSaveWheelchairPlan}" Style="{StaticResource PrimaryAction}" />
          <Button Content="放弃草稿" Click="OnCancelWheelchairDraft" Margin="10,0,0,0" />
         </StackPanel>
        </StackPanel>
        <TextBlock Text="已保存的方案" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" />
        <ComboBox x:Name="WheelchairSelector" ItemsSource="{Binding SavedWheelchairPlans}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWheelchairPlan}" IsEnabled="{Binding CanBeginWheelchair}" />
        <TextBlock Text="{Binding SelectedWheelchairPlanSummary}" Foreground="{DynamicResource Muted}" Margin="0,9,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
         <Button x:Name="WheelchairRunButton" Content="运行方案" Click="OnRunWheelchairPlan" IsEnabled="{Binding CanRunWheelchairPlan}" Style="{StaticResource PrimaryAction}" />
         <Button Content="编辑此方案" Click="OnEditWheelchairPlan" IsEnabled="{Binding CanRunWheelchairPlan}" Margin="10,0,0,0" />
         <Button Content="导出" Click="OnExportWheelchairPlan" IsEnabled="{Binding CanRunWheelchairPlan}" Margin="10,0,0,0" />
         <Button Content="删除" Click="OnDeleteWheelchairPlan" IsEnabled="{Binding CanRunWheelchairPlan}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="运行前请让角色进入方案所属地图。方案只记录坐标和动作名称，分享给别人时对方需要先导入同名动作；导出方案会把动作引用一起带过去，但动作文件本身需要单独分享。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0" />
       </StackPanel>
       <StackPanel x:Name="SchedulePage" Visibility="{Binding IsSchedulePage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="可以建多条定时任务，每条自己命名：选执行内容、设每天时刻或固定间隔。到点由助手自动启动，结束会响一声提示。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
        <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
         <ItemsControl x:Name="ScheduleTaskList" ItemsSource="{Binding ScheduleDrafts}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="{DynamicResource TileBackground}" CornerRadius="8" Padding="10,8" Margin="0,0,0,7">
             <StackPanel>
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="128" /><ColumnDefinition Width="252" />
              <ColumnDefinition Width="118" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <CheckBox Grid.Column="0" Style="{StaticResource FeatureOption}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="是否启用这条任务" AutomationProperties.Name="启用该任务" />
             <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,10,0" ToolTip="任务名称" AutomationProperties.Name="任务名称" />
             <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ScheduleChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Target}" SelectedValuePath="Key" DisplayMemberPath="Label" Margin="0,0,10,0" AutomationProperties.Name="执行内容" />
             <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.ScheduleModeChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding ModeKey}" SelectedValuePath="Key" DisplayMemberPath="Label" Margin="0,0,10,0" ToolTip="定时执行=每天固定时刻；间歇执行=每隔一段时间" AutomationProperties.Name="执行方式" />
             <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Width="84" HorizontalAlignment="Left" ToolTip="每天执行的时刻 HH:mm" AutomationProperties.Name="每天时刻" Visibility="{Binding IsDaily, Converter={StaticResource BoolVisibility}}" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsInterval, Converter={StaticResource BoolVisibility}}">
               <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="70" ToolTip="间隔分钟数 1-1440" AutomationProperties.Name="间隔分钟" />
               <TextBlock Text="分钟" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Muted}" />
              </StackPanel>
             </Grid>
             <StackPanel Grid.Column="5" Orientation="Horizontal">
              <Button Content="立即执行" Click="OnRunSelectedSchedule" Padding="10,5" Margin="0,0,6,0" />
              <Button Content="移除" Click="OnRemoveScheduleTask" Padding="10,5" />
             </StackPanel>
            </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
               <TextBlock Text="开始" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" />
               <ComboBox Width="150" Margin="6,0,16,0" ItemsSource="{Binding DataContext.TaskSoundChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding StartSoundKey}" SelectedValuePath="Key" DisplayMemberPath="Label" ToolTip="默认=跟随上面的全局声音" AutomationProperties.Name="任务开始提示音" />
               <TextBlock Text="结束" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" />
               <ComboBox Width="150" Margin="6,0,0,0" ItemsSource="{Binding DataContext.TaskSoundChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding EndSoundKey}" SelectedValuePath="Key" DisplayMemberPath="Label" ToolTip="默认=跟随上面的全局声音" AutomationProperties.Name="任务结束提示音" />
              </StackPanel>
             </StackPanel>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="列说明：第 2 列是任务名；第 3 列是要执行的内容；第 4 列选“定时执行”就填每天几点，选“间歇执行”就填每隔多少分钟。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
         <Button x:Name="AddScheduleTaskButton" Content="新增任务" Click="OnAddScheduleTask" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="SaveScheduleTasksButton" Content="保存任务" Click="OnSaveScheduleTasks" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="提示音" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="ScheduleSoundOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding ScheduleSound}" Margin="0,0,0,12" AutomationProperties.Name="定时执行提示音"><StackPanel><TextBlock Text="任务开始和结束时播放提示音" FontWeight="SemiBold" /><TextBlock Text="可选内置音色，也可以导入自己的 wav / mp3 / wma" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBlock Text="音量" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ScheduleSoundVolume}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="提示音音量" />
         <TextBlock Grid.Column="2" Text="{Binding SoundVolumeText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" MinWidth="62" />
        </Grid>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="开始声音" VerticalAlignment="Center" />
         <ComboBox Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding ScheduleStartSoundChoice}" DisplayMemberPath="Label" Margin="0,0,8,0" AutomationProperties.Name="开始提示音" />
         <Button Grid.Column="2" Content="试听" Click="OnPreviewStartSound" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="试听开始提示音" />
         <Button Grid.Column="3" Content="导入音频…" Click="OnImportStartSound" Padding="12,6" AutomationProperties.Name="导入开始提示音" />
        </Grid>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="结束声音" VerticalAlignment="Center" />
         <ComboBox Grid.Column="1" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding ScheduleEndSoundChoice}" DisplayMemberPath="Label" Margin="0,0,8,0" AutomationProperties.Name="结束提示音" />
         <Button Grid.Column="2" Content="试听" Click="OnPreviewEndSound" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="试听结束提示音" />
         <Button Grid.Column="3" Content="导入音频…" Click="OnImportEndSound" Padding="12,6" AutomationProperties.Name="导入结束提示音" />
        </Grid>
        <TextBlock Text="{Binding SoundSummary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,14" />
        <TextBlock Text="{Binding ScheduleStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />
        <TextBlock Text="说明：到点时如果已有任务在运行，本次会跳过并记日志；助手中途退出不会补跑错过的任务。定时任务保存在程序目录的 schedule.json。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
       </StackPanel>
       <StackPanel x:Name="GrowthPage" Visibility="{Binding IsGrowthPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="养成计算" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
         <TextBlock Text="{Binding GrowthVersionText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,12,0" />
         <Button Content="更新数据（promilia.wiki）" Click="OnUpdateGrowthData" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="导入本地 JSON…" Click="OnImportGrowthData" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding GrowthStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
         <StackPanel>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="类型" VerticalAlignment="Center" />
           <ComboBox Grid.Column="1" ItemsSource="{Binding GrowthModules}" SelectedItem="{Binding SelectedGrowthModule}" Margin="0,0,12,0" AutomationProperties.Name="养成类型" />
          </Grid>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="对象" VerticalAlignment="Center" />
           <ComboBox Grid.Column="1" ItemsSource="{Binding GrowthEntries}" SelectedItem="{Binding SelectedGrowthEntry}" DisplayMemberPath="Title" AutomationProperties.Name="养成对象" />
          </Grid>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="从" VerticalAlignment="Center" />
           <TextBox Grid.Column="1" Text="{Binding GrowthFromLevel}" Margin="0,0,10,0" AutomationProperties.Name="当前等级" />
           <TextBlock Grid.Column="2" Text="级　已有经验" VerticalAlignment="Center" FontSize="11" />
           <TextBox Grid.Column="3" Text="{Binding GrowthOwnedExp}" Margin="0,0,10,0" AutomationProperties.Name="当前经验" />
           <TextBox Grid.Column="4" Text="{Binding GrowthFromRank}" AutomationProperties.Name="当前阶级" />
           <TextBlock Grid.Column="5" Text="阶（源脉/角色阶级）" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
          </Grid>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="到" VerticalAlignment="Center" />
           <TextBox Grid.Column="1" Text="{Binding GrowthToLevel}" Margin="0,0,10,0" AutomationProperties.Name="目标等级" />
           <TextBlock Grid.Column="2" Text="级" VerticalAlignment="Center" FontSize="11" />
           <TextBox Grid.Column="3" Text="{Binding GrowthToRank}" Margin="0,0,10,0" AutomationProperties.Name="目标阶级" />
           <TextBlock Grid.Column="4" Text="阶" VerticalAlignment="Center" FontSize="11" />
           <TextBlock Grid.Column="5" Text="（升阶材料按阶级区间累加）" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
          </Grid>
          <CheckBox Style="{StaticResource FeatureOption}" IsChecked="{Binding GrowthIncludeRunes}" Margin="0,0,0,4" AutomationProperties.Name="计入符文材料"><StackPanel><TextBlock Text="计入符文（星光）材料" FontWeight="SemiBold" /><TextBlock Text="每个阶级有 5 个符文的微粒与尤尼消耗" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
         </StackPanel>
        </Border>

        <TextBlock Text="{Binding GrowthSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{Binding GrowthCrystalText}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="缺口清单（「拥有」可改，自动算还差多少）" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" />
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
         <ItemsControl ItemsSource="{Binding GrowthMaterials}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="{DynamicResource TileBackground}" CornerRadius="7" Padding="10,6" Margin="0,0,0,5">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
             <TextBlock Grid.Column="1" Text="{Binding Need, StringFormat=需要 {0:N0}}" VerticalAlignment="Center" FontSize="11" />
             <TextBox Grid.Column="2" Text="{Binding Owned}" Margin="0,0,10,0" FontSize="11" AutomationProperties.Name="拥有数量" />
             <TextBlock Grid.Column="3" Text="{Binding Suggestion}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" />
            </Grid>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </StackPanel>
       <StackPanel x:Name="GachaPage" Visibility="{Binding IsGachaPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="抽卡分析" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Border Background="{DynamicResource TileBackground}" CornerRadius="8" Padding="16,14">
         <TextBlock Text="这个页面先占位，内容待补充。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
        </Border>
       </StackPanel>
       <StackPanel x:Name="ToolsPage" Visibility="{Binding IsToolsPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="语言包" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="把导出的语言包放进 程序目录\语言包\&lt;代码&gt;\ 后点刷新；应用前脚本会自动备份，可随时还原。切换时游戏必须关闭。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <ComboBox Width="300" ItemsSource="{Binding LanguagePacks}" SelectedItem="{Binding SelectedLanguagePack}" DisplayMemberPath="Label" Margin="0,0,10,0" AutomationProperties.Name="语言包选择" />
         <Button Content="应用语言包" Click="OnApplyLanguagePack" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding CanApplyLanguagePack}" />
         <Button Content="还原备份" Click="OnRestoreLanguage" Padding="12,6" Margin="0,0,8,0" IsEnabled="{Binding CanApplyLanguagePack}" />
         <Button Content="刷新列表" Click="OnRefreshLanguagePacks" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding LanguageStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />

        <TextBlock Text="诊断包" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="把日志、设置、模板清单、最近失败帧和系统信息打包成一个 zip，方便反馈问题。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button Content="导出诊断包…" Click="OnExportDiagnosticBundle" Padding="12,6" Margin="0,0,0,8" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding DiagnosticsStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />

        <TextBlock Text="模板热更新" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="游戏更新后模板可能失效：下载新的模板包 zip（或从 update-source.json 的 TemplatePackUrl 拉取），会先逐个校验再替换，旧文件自动备份到 assets_backup_时间戳。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <Button Content="选择模板包 zip…" Click="OnInstallTemplatePackFile" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="从配置地址更新" Click="OnInstallTemplatePackFromSource" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="模板标注…" Click="OnAnnotateTemplate" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding TemplatePackSourceText}" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="{Binding TemplateStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />
        <TextBlock Text="识别调试（失败帧）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="任务失败时会自动保存最后一帧和原因。这里可以看是哪个模板没认出来，双击打开图片。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <Button Content="刷新" Click="OnRefreshFailureFrames" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="全部删除" Click="OnDeleteFailureFrames" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding DebugStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
         <ItemsControl ItemsSource="{Binding FailureFrames}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="{DynamicResource TileBackground}" CornerRadius="7" Padding="10,8" Margin="0,0,0,6" MouseLeftButtonDown="OnOpenFailureFrame" Cursor="Hand" ToolTip="{Binding ImagePath}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding WhenText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" />
             <TextBlock Grid.Column="1" Text="{Binding TaskName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
             <TextBlock Grid.Column="2" Text="{Binding Reason}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="6,0" />
             <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
             <Button Grid.Column="4" Content="复测" Click="OnRegressionOnFrame" Padding="10,4" FontSize="11" />
            </Grid>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding RegressionSummary}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
         <ItemsControl ItemsSource="{Binding RegressionProbes}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <TextBlock Text="{Binding Text}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Margin="0,1" />
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="配置档" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="把当前设置、定时任务、动作录制、轮椅方案整体存成一份配置档，换账号或换设备时一键切回。应用时会先把现有数据备份到 profiles\_backup_时间戳。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <ComboBox Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,0,8,0" AutomationProperties.Name="配置档列表" />
         <Button Content="应用" Click="OnApplyProfile" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="删除" Click="OnDeleteProfile" Padding="12,6" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
         <TextBox Width="220" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="配置档名称" ToolTip="新配置档的名字" />
         <Button Content="保存当前" Click="OnSaveProfile" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding ProfileStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />
        <TextBlock Text="运行报表" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding RunReportSummary}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <Button Content="刷新" Click="OnRefreshRunHistory" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="导出 CSV…" Click="OnExportRunHistory" Padding="12,6" Margin="0,0,8,0" />
         <Button Content="清空" Click="OnClearRunHistory" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding ReportStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
         <ItemsControl ItemsSource="{Binding RunHistory}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="{DynamicResource TileBackground}" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding StartedText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" />
             <TextBlock Grid.Column="1" Text="{Binding TaskName}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
             <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" FontSize="11" />
             <TextBlock Grid.Column="3" Text="{Binding ResultText}" VerticalAlignment="Center" FontSize="11" />
             <TextBlock Grid.Column="4" Text="{Binding Message}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
            </Grid>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </StackPanel>
       <StackPanel x:Name="SettingsPage" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="游戏启动文件" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource TileBackground}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,9" Margin="0,0,8,0"><TextBox x:Name="GameExecutablePathBox" Text="{Binding GameExecutablePath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" VerticalContentAlignment="Center" ToolTip="{Binding GameExecutablePath}" AutomationProperties.Name="游戏启动文件路径" /></Border>
         <Button x:Name="ChooseGameExecutableButton" Grid.Column="1" Content="选择文件" Click="OnChooseGameExecutable" Padding="14,9" />
        </Grid>
        <CheckBox x:Name="AutoConnectOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding AutoConnect}" Content="启动助手后自动连接游戏画面" Margin="0,0,0,18" />
        <CheckBox x:Name="AutoRunDailyOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding AutoRunDaily}" Content="启动助手后自动运行一条龙" Margin="0,0,0,18" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,20" />
        <CheckBox x:Name="LowPerformanceModeOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding LowPerformanceMode}" Margin="0,0,0,18">
         <StackPanel><TextBlock Text="低配模式" FontWeight="SemiBold" /><TextBlock Text="低配设备可开启，降低任务执行速度" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
        </CheckBox>
        <CheckBox x:Name="DisablePreviewOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding DisablePreview}" Margin="0,0,0,18">
         <StackPanel><TextBlock Text="关闭画面预览" FontWeight="SemiBold" /><TextBlock Text="关闭后隐藏首页画面预览" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
        </CheckBox>
        <CheckBox x:Name="DarkModeOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding DarkMode}" Checked="OnDarkModeChanged" Unchecked="OnDarkModeChanged">
         <StackPanel><TextBlock Text="深色模式" FontWeight="SemiBold" /><TextBlock Text="纯黑背景、白色文字、明亮灰边框；勾选后立即生效，无需重启" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
        </CheckBox>
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="外观与透明度" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="预览：这三行分别受三个滑杆控制" FontSize="12" />
          <TextBlock Text="这段说明文字跟随「文字」滑杆；下面分隔线跟随「界面元素」；本卡片的底色跟随「背景表面」。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
           <Button Content="强调色按钮" Style="{StaticResource PrimaryAction}" Padding="12,6" IsHitTestVisible="False" />
           <Border Width="18" Height="18" CornerRadius="9" Background="{Binding AccentPreview}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
         </StackPanel>
        </Border>
        <TextBlock Text="三个滑杆分别控制：界面元素（边框/分隔线/强调色）、文字、背景表面（卡片/输入框/侧栏）。拖动即时生效，松手后自动保存。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="界面元素" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="False" SmallChange="1" Value="{Binding UiOpacityValue}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="界面元素透明度" />
         <TextBlock Grid.Column="2" Text="{Binding UiOpacityText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="文字" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="False" SmallChange="1" Value="{Binding TextOpacityValue}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="文字透明度" />
         <TextBlock Grid.Column="2" Text="{Binding TextOpacityText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="背景表面" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="False" SmallChange="1" Value="{Binding BackgroundOpacityValue}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="背景透明度" />
         <TextBlock Grid.Column="2" Text="{Binding BackgroundOpacityText}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <TextBlock Text="界面颜色" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8" />
        <TextBlock Text="按红/绿/蓝三原色配比调出主色，会应用到按钮、选中项、滑杆填充、分隔提示等强调元素。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="红" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" IsSnapToTickEnabled="False" Value="{Binding AccentRed}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="界面颜色红" />
         <TextBlock Grid.Column="2" Text="{Binding AccentRed}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="绿" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" IsSnapToTickEnabled="False" Value="{Binding AccentGreen}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="界面颜色绿" />
         <TextBlock Grid.Column="2" Text="{Binding AccentGreen}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
         <TextBlock Text="蓝" VerticalAlignment="Center" />
         <Slider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" IsSnapToTickEnabled="False" Value="{Binding AccentBlue}" ValueChanged="OnAppearanceSliderChanged" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="界面颜色蓝" />
         <TextBlock Grid.Column="2" Text="{Binding AccentBlue}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,18">
         <Border Width="52" Height="26" CornerRadius="6" Background="{Binding AccentPreview}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
         <TextBlock Text="{Binding AccentHexText}" VerticalAlignment="Center" Margin="10,0,16,0" Foreground="{DynamicResource Muted}" FontFamily="Consolas, Segoe UI" />
         <Button Content="恢复默认颜色" Click="OnResetAccent" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="背景图" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <Button x:Name="ChooseBackgroundButton" Content="选择背景图…" Click="OnImportBackground" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="ClearBackgroundButton" Content="清除背景" Click="OnClearBackground" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding BackgroundStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
         <RadioButton x:Name="BackgroundStretchOption" GroupName="BackgroundMode" Content="拉伸铺满" IsChecked="{Binding BackgroundStretchMode}" Margin="0,0,20,0" />
         <RadioButton x:Name="BackgroundFitOption" GroupName="BackgroundMode" Content="保持比例，上下/左右留白" IsChecked="{Binding BackgroundFitMode}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="悬浮窗与通知" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="悬浮窗是置顶小条，显示当前状态和进度，可拖动；托盘图标在最小化后也能用右键菜单暂停/停止/退出。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
        <CheckBox x:Name="ShowHudOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding ShowHud}" Margin="0,0,0,10" AutomationProperties.Name="显示悬浮窗"><StackPanel><TextBlock Text="显示悬浮窗（HUD）" FontWeight="SemiBold" /><TextBlock Text="置顶小条：当前步骤 + 暂停/继续 + 停止" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <CheckBox x:Name="ShowTrayOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding ShowTrayIcon}" Margin="0,0,0,10" AutomationProperties.Name="显示托盘图标"><StackPanel><TextBlock Text="显示托盘图标" FontWeight="SemiBold" /><TextBlock Text="双击托盘恢复窗口；右键菜单可暂停/停止/退出" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <CheckBox x:Name="MinimizeToTrayOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10" AutomationProperties.Name="最小化到托盘"><StackPanel><TextBlock Text="最小化时收进托盘" FontWeight="SemiBold" /><TextBlock Text="需要同时开启托盘图标" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <CheckBox x:Name="NotifyOnEndOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding NotifyOnTaskEnd}" Margin="0,0,0,10" AutomationProperties.Name="任务结束通知"><StackPanel><TextBlock Text="任务结束时弹出通知" FontWeight="SemiBold" /><TextBlock Text="成功或失败都会在右下角显示一条，4.5 秒后自动消失" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="显示在" VerticalAlignment="Center" />
         <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedValue="{Binding OverlayMonitor}" SelectedValuePath="Index" DisplayMemberPath="Label" Margin="0,0,12,0" AutomationProperties.Name="显示器选择" />
         <TextBlock Grid.Column="2" Text="{Binding OverlayMonitorLabel}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Grid>
        <Border Height="0" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="识别与容错" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="超时越长越稳但更慢；重试间隔与动作后等待太短容易误点。卡死检测填 0 表示关闭。修改后下次任务生效。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="单步超时（秒）" VerticalAlignment="Center" />
         <TextBox Grid.Column="1" Text="{Binding StepTimeoutSeconds}" Margin="0,0,16,0" AutomationProperties.Name="单步超时" />
         <TextBlock Grid.Column="2" Text="重试间隔（秒）" VerticalAlignment="Center" />
         <TextBox Grid.Column="3" Text="{Binding StepRetrySeconds}" AutomationProperties.Name="重试间隔" />
        </Grid>
        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="动作后等待（毫秒）" VerticalAlignment="Center" />
         <TextBox Grid.Column="1" Text="{Binding ActionSettleMs}" Margin="0,0,16,0" AutomationProperties.Name="动作后等待" />
         <TextBlock Grid.Column="2" Text="卡死检测（秒）" VerticalAlignment="Center" />
         <TextBox Grid.Column="3" Text="{Binding StuckWarningSeconds}" AutomationProperties.Name="卡死检测" />
        </Grid>
        <CheckBox x:Name="AutoRecoverOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding AutoRecover}" Margin="0,4,0,0" AutomationProperties.Name="失败后自动恢复"><StackPanel><TextBlock Text="任务失败后自动按 Esc 尝试回到主界面" FontWeight="SemiBold" /><TextBlock Text="最多按 3 次；不会自动重跑任务，只是把游戏退回主菜单" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel></CheckBox>
        <Border Height="0" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="游戏语言切换（实验）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="游戏的语言资源打包在 AssetBundle 里，无法在程序内直接切换。把语言包放进“语言包\”目录后，运行 脚本\Switch-GameLanguage.ps1 即可替换或还原（脚本会自动探测游戏目录并先备份）。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
         <Button x:Name="OpenPackFolderButton" Content="打开语言包目录" Click="OnOpenPackFolder" Style="{StaticResource PrimaryAction}" />
         <Button x:Name="OpenScriptFolderButton" Content="打开脚本目录" Click="OnOpenScriptFolder" Margin="10,0,0,0" />
         <Button x:Name="OpenLanguageHelpButton" Content="查看说明" Click="OnOpenLanguageHelp" Margin="10,0,0,0" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="任务快捷键" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="支持自定义快捷键" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12" />
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
         <TextBlock Text="暂停 / 继续" VerticalAlignment="Center" Margin="0,0,20,10" />
         <TextBox x:Name="PauseHotkeyBox" Grid.Column="1" Tag="pause" Text="{Binding PauseHotkeyText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Style="{StaticResource CompactTextBox}" Width="160" Margin="0,0,0,10" AutomationProperties.Name="暂停或继续快捷键" ToolTip="可单独使用 F 键，或同时按住 Ctrl / Alt；可附加 Shift" PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocusChanged" LostKeyboardFocus="OnHotkeyFocusChanged" />
         <TextBlock Grid.Row="1" Text="停止所有任务" VerticalAlignment="Center" Margin="0,0,20,0" />
         <TextBox x:Name="StopHotkeyBox" Grid.Row="1" Grid.Column="1" Tag="stop" Text="{Binding StopHotkeyText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" Style="{StaticResource CompactTextBox}" Width="160" AutomationProperties.Name="停止所有任务快捷键" ToolTip="可单独使用 F 键，或同时按住 Ctrl / Alt；可附加 Shift" PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocusChanged" LostKeyboardFocus="OnHotkeyFocusChanged" />
        </Grid>
        <TextBlock x:Name="HotkeyValidationMessage" Text="{Binding HotkeyError}" Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource WarningInk}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,18" />
        <TextBlock Text="程序更新" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox x:Name="AutoUpdateOption" Style="{StaticResource FeatureOption}" IsChecked="{Binding AutoUpdate}" Margin="0,0,0,14">
         <StackPanel><TextBlock Text="自动更新" FontWeight="SemiBold" /><TextBlock Text="每天首次启动时检查，有更新时提醒" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
        </CheckBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
         <TextBlock Text="更新源" VerticalAlignment="Center" Margin="0,0,12,0" />
         <ComboBox x:Name="UpdateSourceBox" Width="120" SelectedIndex="0" IsEnabled="{Binding CanCheckUpdates}" AutomationProperties.Name="更新源"><ComboBoxItem Content="GitHub" /></ComboBox>
         <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdates" IsEnabled="{Binding CanCheckUpdates}" Padding="14,7" Margin="12,0,0,0" />
         <Button Content="取消" Click="OnCancelUpdate" Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolVisibility}}" Padding="14,7" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock Text="{Binding SettingsError}" Visibility="{Binding HasSettingsError, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource WarningInk}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding TaskStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="以管理员重启" Click="OnRestartElevated" Visibility="{Binding RequiresElevation, Converter={StaticResource BoolVisibility}}" Padding="12,7" Margin="0,0,8,0" />
        <Button x:Name="CancelTaskButton" Content="停止任务" Click="OnCancelTask" IsEnabled="{Binding CanStopTask}" Padding="14,7" ToolTip="{Binding StopTaskTooltip}" />
       </StackPanel>
      </Grid>
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="ConsolePanels" Grid.Row="3" Height="252" Visibility="{Binding IsHomePage, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" />
     <ColumnDefinition x:Name="PreviewGapColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="20" /><Style.Triggers><DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
     <ColumnDefinition x:Name="PreviewColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="300" /><Style.Triggers><DataTrigger Binding="{Binding ShowPreview}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <Border x:Name="LogPanel" Style="{StaticResource Card}" Padding="20,18">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,12"><TextBlock Text="日志" FontSize="15" FontWeight="SemiBold" /><Button Content="打开文件夹" Click="OnOpenLogs" HorizontalAlignment="Right" FontSize="10" Padding="8,4" /></Grid>
      <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="{Binding LogError}" Visibility="{Binding HasLogError, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <ItemsControl ItemsSource="{Binding Logs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,13" LineHeight="19" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      </Grid>
     </Grid>
    </Border>
    <Border x:Name="PreviewPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,14,12" Visibility="{Binding ShowPreview, Converter={StaticResource BoolVisibility}}">
     <StackPanel>
      <Grid Margin="2,0,2,12"><TextBlock Text="游戏画面" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="实时预览" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" /></Grid>
      <Border Background="{DynamicResource PreviewBackground}" CornerRadius="7" Height="150" ClipToBounds="True">
       <Grid>
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="游戏实时画面" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PreviewMuted}" FontSize="28" HorizontalAlignment="Center" /><TextBlock Text="{Binding PreviewHint}" Foreground="{DynamicResource PreviewInk}" FontSize="12" Margin="0,12,0,0" />
        </StackPanel>
       </Grid>
      </Border>
      <TextBlock Text="{Binding FrameInfo}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,12,0,0" />
      <TextBlock Text="{Binding FrameTime}" FontSize="10" Foreground="{DynamicResource Subtle}" Margin="2,5,0,0" />
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock Grid.Row="4" Text="画面仅在本机显示" Visibility="{Binding ShowPreviewFootnote, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Subtle}" FontSize="10" HorizontalAlignment="Right" Margin="0,14,2,0" />
  </Grid>
  <Canvas x:Name="DailyDragOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
   <Image x:Name="DailyDragImage" Opacity="0.65" Stretch="Fill">
    <Image.Effect><DropShadowEffect Color="#28464D" BlurRadius="12" ShadowDepth="3" Opacity="0.22" /></Image.Effect>
   </Image>
  </Canvas>
 </Grid>
</Window>
