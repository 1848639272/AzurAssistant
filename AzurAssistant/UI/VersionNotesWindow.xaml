<Window x:Class="AzurAssistant.UI.VersionNotesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="蔚蓝助手 · 版本说明" Width="630" Height="505" MinWidth="400" MinHeight="290"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}"
 FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="24"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
 </Window.Resources>
 <Grid Margin="26,20">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
    <TextBlock Text="蔚蓝助手使用说明" FontSize="20" FontWeight="Bold" LineHeight="30" />
    <TextBlock Text="蔚蓝助手（AzurAssistant）是一款开源、免费的《蓝色星原：旅谣》辅助工具，可从下方项目地址免费下载。" />
    <TextBlock Text="助手采用纯视觉识别，通过游戏画面判断当前状态，再模拟键盘和鼠标完成操作。运行过程中不修改游戏文件，也不读写游戏进程内存。" />
    <TextBlock>当前版本为 <Bold>v1.0.0_rc1 开发预览版</Bold>，部分功能可能暂时无法使用。</TextBlock>
    <TextBlock Text="账号风险提示" FontSize="16" FontWeight="Bold" Margin="0,4,0,6" />
    <TextBlock Text="模拟操作仍可能被游戏检测到，并可能导致账号受限或封禁。请根据自身情况决定是否使用，并自行承担使用本工具的风险及相应责任。" />
    <TextBlock Margin="0,2,0,0">B 站账号：<Bold>o柴v柴o</Bold></TextBlock>
    <TextBlock>项目地址：<Hyperlink NavigateUri="https://github.com/1848639272/AzurAssistant" RequestNavigate="OpenProject" Foreground="{DynamicResource NavigationSelectedInk}">github.com/1848639272/AzurAssistant</Hyperlink></TextBlock>
   </StackPanel>
  </ScrollViewer>
  <Button Grid.Row="1" x:Name="AcknowledgeButton" Content="我已了解" IsDefault="True" HorizontalAlignment="Right" Padding="20,7" Margin="0,12,0,0" Click="Acknowledge"/>
 </Grid>
</Window>
