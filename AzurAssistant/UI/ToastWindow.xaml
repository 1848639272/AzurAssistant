<Window x:Class="AzurAssistant.UI.ToastWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="通知" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
 Width="360" ShowActivated="False" IsHitTestVisible="False" Focusable="False">
 <Border Background="#EE121212" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,11"
         TextElement.Foreground="White">
  <StackPanel>
   <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" AutomationProperties.Name="通知标题" />
   <TextBlock x:Name="MessageText" FontSize="11" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,5,0,0"
              MaxHeight="90" AutomationProperties.Name="通知内容" />
  </StackPanel>
 </Border>
</Window>
