<Window x:Class="AzurAssistant.UI.HudWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="蔚蓝助手 HUD" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height"
 Width="360" MinHeight="60" ShowActivated="False" AutomationProperties.Name="悬浮窗">
 <Border Background="#CC101010" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="12,9"
         MouseLeftButtonDown="OnDrag">
  <StackPanel>
   <StackPanel Orientation="Horizontal">
    <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
    <TextBlock Text="蔚蓝助手" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
    <TextBlock Text="{Binding TaskStatus}" FontSize="12" Foreground="White" Margin="8,0,0,0"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" AutomationProperties.Name="HUD 状态" />
   </StackPanel>
   <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding HudDetail}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" AutomationProperties.Name="HUD 详情" />
    <Button Grid.Column="1" Content="暂停/继续" Click="OnPause" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
    <Button Grid.Column="2" Content="停止" Click="OnStop" Padding="8,4" FontSize="11" />
   </Grid>
  </StackPanel>
 </Border>
</Window>
