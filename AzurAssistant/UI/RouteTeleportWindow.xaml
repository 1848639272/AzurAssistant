<Window x:Class="AzurAssistant.UI.RouteTeleportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="前往目标传送点" Width="410" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI">
 <StackPanel Margin="22">
  <TextBlock Text="目标地图" Margin="0,0,0,6" />
  <ComboBox ItemsSource="{Binding NavigationMaps}" SelectedItem="{Binding SelectedTeleportMap}" DisplayMemberPath="Name"/>
  <TextBlock Text="传送点" Margin="0,14,0,6" />
  <ComboBox ItemsSource="{Binding TeleportChoices}" SelectedItem="{Binding SelectedTeleport}" DisplayMemberPath="Name"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="取消" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/><Button Content="前往并记录" IsDefault="True" Click="OnConfirm" Padding="14,6"/>
  </StackPanel>
 </StackPanel>
</Window>
