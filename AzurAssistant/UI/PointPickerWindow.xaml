<Window x:Class="AzurAssistant.UI.PointPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="拾取坐标" WindowStyle="None" AllowsTransparency="True" Background="#66000000"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
 Cursor="Cross" AutomationProperties.Name="坐标拾取">
 <Canvas x:Name="Root">
  <Line x:Name="HLine" Stroke="#FF19C3B6" StrokeThickness="1" />
  <Line x:Name="VLine" Stroke="#FF19C3B6" StrokeThickness="1" />
  <Border x:Name="Readout" Background="#F2FFFFFF" CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
   <StackPanel>
    <TextBlock x:Name="PositionText" FontSize="13" FontWeight="SemiBold" Foreground="#FF1B1B24" />
    <TextBlock x:Name="HintText" FontSize="11" Foreground="#FF55606B" Text="左键拾取 · 右键或 Esc 取消" Margin="0,4,0,0" />
   </StackPanel>
  </Border>
 </Canvas>
</Window>
